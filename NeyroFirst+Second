# глобальные состояния
loaded_X = None
loaded_y = None
loaded_dataset_path = None
current_population = None
suspicious_dict_cache = None

def browse_suspicious_file():
    p = filedialog.askopenfilename(title="Выберите JSON файл со словами",
                                   filetypes=[("JSON files", "*.json"), ("All files", "*.*")])
    if p:
        suspicious_entry.delete(0, tk.END)
        suspicious_entry.insert(0, p)

def load_dataset_action():
    global loaded_X, loaded_y, loaded_dataset_path, suspicious_dict_cache
    p = filedialog.askopenfilename(title="Выберите CSV/JSON с базой",
                                   filetypes=[("CSV files", "*.csv"), ("JSON files", "*.json"), ("All files", "*.*")])
    if not p:
        return
    suspicious_path = suspicious_entry.get().strip() or DEFAULT_SUSPICIOUS_FILE
    suspicious_dict_cache = load_suspicious_words(suspicious_path)
    try:
        X, y = prepare_dataset_from_file(p, suspicious_dict_cache)
    except Exception as e:
        messagebox.showerror("Ошибка", f"Не удалось загрузить базу: {e}")
        return
    loaded_X = X
    loaded_y = y
    loaded_dataset_path = p
    output_box.insert(tk.END, f"Загружена база: {p}\n")
    output_box.insert(tk.END, f"Количество записей: {len(y)} (фишинг={sum(y)}, безопасно={len(y)-sum(y)})\n\n")

def create_population_action():
    global current_population
    try:
        population_size = int(pop_entry.get().strip())
        if population_size <= 0:
            raise ValueError
    except Exception:
        messagebox.showerror("Ошибка", "Введите корректное целое число для размера популяции!")
        return

    if loaded_X is None:
        messagebox.showinfo("Инфо", "Желательно сначала загрузить обучающую базу, но можно и без неё.")
    suspicious_path = suspicious_entry.get().strip() or DEFAULT_SUSPICIOUS_FILE
    suspicious_dict = load_suspicious_words(suspicious_path)

    # берём число признаков по extract_features
    sample_feats = extract_features("example.com", suspicious_dict)
    n_features = len(sample_feats)
    hidden_layers = [10, 5]
    output_neurons = 1

    population = [create_individual(n_features, hidden_layers, output_neurons)
                  for _ in range(population_size)]
    current_population = population

    output_box.insert(tk.END, f"Популяция создана: {population_size} индивидов\n")
    output_box.insert(tk.END, "Можно запустить обучение на загруженной базе (если есть).\n\n")

def train_population_action():
    global current_population, loaded_X, loaded_y, suspicious_dict_cache
    if current_population is None:
        messagebox.showerror("Ошибка", "Сначала создайте популяцию.")
        return
    if loaded_X is None or loaded_y is None:
        messagebox.showerror("Ошибка", "Сначала загрузите обучающую базу (CSV/JSON).")
        return

    # параметры обучения берём из полей UI или используем значения по умолчанию
    try:
        epochs = int(epochs_entry.get().strip())
    except Exception:
        epochs = 5
    try:
        lr = float(lr_entry.get().strip())
    except Exception:
        lr = 0.05
    try:
        batch_size = int(batch_entry.get().strip())
    except Exception:
        batch_size = 16

    output_box.insert(tk.END, f"Обучение популяции: epochs={epochs}, lr={lr}, batch={batch_size}\n")
    output_box.see(tk.END)

    # метрики до обучения (для каждого индивида) — покажем среднее и лучший
    before_losses = []
    before_accs = []
    for indiv in current_population:
        loss_b, acc_b = evaluate_on_dataset(indiv, loaded_X, loaded_y)
        before_losses.append(loss_b)
        before_accs.append(acc_b)
    output_box.insert(tk.END, f"Before  — avg loss: {np.mean(before_losses):.4f}, avg acc: {np.mean(before_accs):.4f}, best acc: {np.max(before_accs):.4f}\n")

    # callback для прогресса
    def progress_cb(i, total):
        output_box.insert(tk.END, f"  Обучен индивид {i}/{total}\n")
        output_box.see(tk.END)

    # обучаем
    current_population, metrics = train_population(current_population, loaded_X, loaded_y, lr=lr, epochs=epochs, batch_size=batch_size, progress_callback=progress_cb)

    # метрики после
    after_losses = [m['after'][0] for m in metrics]
    after_accs = [m['after'][1] for m in metrics]
    output_box.insert(tk.END, f"After   — avg loss: {np.mean(after_losses):.4f}, avg acc: {np.mean(after_accs):.4f}, best acc: {np.max(after_accs):.4f}\n\n")

    # покажем лучший индивид
    best_idx = int(np.argmax(after_accs))
    best_indiv = current_population[best_idx]
    loss_best, acc_best = evaluate_on_dataset(best_indiv, loaded_X, loaded_y)
    output_box.insert(tk.END, f"🏆 Лучший индивид: #{best_idx+1} — loss: {loss_best:.4f}, acc: {acc_best:.4f}\n")
    output_box.insert(tk.END, "Можно протестировать любой URL в поле и сравнить предсказание лучшего индивида.\n\n")

def test_single_url_with_best():
    global current_population, loaded_X, loaded_y
    url = url_entry.get().strip()
    if not url:
        messagebox.showerror("Ошибка", "Введите ссылку для теста.")
        return
    if current_population is None:
        messagebox.showerror("Ошибка", "Создайте и обучите популяцию.")
        return
    # если есть обученная популяция, найдём лучшего по текущей базе (если есть)
    best = None
    best_score = -1.0
    if loaded_X is not None:
        for indiv in current_population:
            _, acc = evaluate_on_dataset(indiv, loaded_X, loaded_y)
            if acc > best_score:
                best_score = acc
                best = indiv
    else:
        best = current_population[0]
    suspicious_path = suspicious_entry.get().strip() or DEFAULT_SUSPICIOUS_FILE
    suspicious_dict = load_suspicious_words(suspicious_path)
    feats = extract_features(url, suspicious_dict)
    pred = forward_predict(feats, best)
    label = "фишинг" if pred >= 0.5 else "безопасен"
    output_box.insert(tk.END, f"Тест URL: {url}\n  Признаки: {feats}\n  Предсказание (prob): {pred:.4f} -> {label}\n\n")

