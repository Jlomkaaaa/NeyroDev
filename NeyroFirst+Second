DEFAULT_SUSPICIOUS_FILE = "suspicious_words.json"

# ----------------------------
# Работа с suspicious_words.json
# ----------------------------
def create_default_suspicious_file(path=DEFAULT_SUSPICIOUS_FILE):
    default = {
        "secure": 1.0,
        "login": 0.9,
        "verify": 0.8,
        "bank": 1.2,
        "account": 1.0,
        "update": 0.7,
        "confirm": 0.6,
        "paypal": 1.5
    }
    with open(path, "w", encoding="utf-8") as f:
        json.dump(default, f, ensure_ascii=False, indent=2)
    return default

def load_suspicious_words(path=DEFAULT_SUSPICIOUS_FILE):
    if not os.path.exists(path):
        words = create_default_suspicious_file(path)
        return words
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
            if not isinstance(data, dict):
                raise ValueError("Файл должен содержать объект (словарь).")
            cleaned = {}
            for k, v in data.items():
                if not isinstance(k, str):
                    continue
                try:
                    wt = float(v)
                except Exception:
                    wt = 1.0
                cleaned[k.lower()] = wt
            return cleaned
    except Exception as e:
        messagebox.showwarning("Warning", f"Не удалось загрузить {path}: {e}\nСоздан файл с примерами.")
        words = create_default_suspicious_file(path)
        return words

# ----------------------------
# Извлечение признаков
# ----------------------------
def extract_features(url, suspicious_dict):
    """
    Возвращает признаки:
    [length, num_digits, num_hyphens, num_dots, suspicious_score, entropy, mixed_alphabet_suspicion]
    """
    parsed = urlparse(url)
    domain = parsed.netloc if parsed.netloc else parsed.path
    domain = domain.strip().lower()
    domain = domain.split(':')[0]

    length = len(domain)
    num_digits = sum(c.isdigit() for c in domain)
    num_hyphens = domain.count('-')
    num_dots = domain.count('.')

    suspicious_score = 0.0
    for word, weight in suspicious_dict.items():
        if word and word in domain:
            suspicious_score += float(weight)

    def calculate_entropy(s):
        if len(s) == 0:
            return 0.0
        prob = [float(s.count(c)) / len(s) for c in dict.fromkeys(list(s))]
        return -sum([p * math.log(p, 2) for p in prob])
    entropy = calculate_entropy(domain)

    mixed_alphabet_suspicion = 0.0
    # более продвинутый анализ смешения алфавитов
    if re.search(r'[а-яА-Я]', domain) and re.search(r'[a-zA-Z]', domain):
        mixed_alphabet_suspicion = 0.7
    elif num_digits > 3:
        mixed_alphabet_suspicion = 0.5

    # нормализуем признаки (простая нормализация: длина / 100, цифры/10 и т.п.)
    # (не обязательно, но помогает при обучении)
    return [
        float(length) / 100.0,
        float(num_digits) / 10.0,
        float(num_hyphens) / 10.0,
        float(num_dots) / 10.0,
        round(suspicious_score / 5.0, 4),  # масштабируем вес
        round(entropy / 10.0, 4),
        round(mixed_alphabet_suspicion, 4)
    ]

# ----------------------------
# Этап 1: Создание индивидов (популяция)
# ----------------------------
def create_individual(n_features, hidden_layers, output_neurons):
    layers = [n_features] + hidden_layers + [output_neurons]
    weights = []
    for i in range(len(layers) - 1):
        # Инициализация маленькими значениями
        w = np.random.uniform(-0.5, 0.5, size=(layers[i], layers[i + 1]))
        weights.append(w)
    return weights

# ----------------------------
# Нейросетевые утилиты (forward/backprop)
# ----------------------------
def sigmoid(x):
    return 1.0 / (1.0 + np.exp(-x))

def sigmoid_deriv(y):
    return y * (1.0 - y)  # y = sigmoid(x)

def tanh_deriv(y):
    return 1.0 - np.square(y)  # y = tanh(x)

def forward_store_activations(features, weights):
    """
    Прямой проход, возвращает список активаций и входов (pre-activation)
    activations: [a0 (input), a1, a2, ..., output]
    zs: pre-activation values for each layer (для backprop)
    """
    a = np.array(features, dtype=float)
    activations = [a]
    zs = []
    for i, w in enumerate(weights):
        z = np.dot(a, w)  # shape (next_layer,)
        zs.append(z)
        if i < len(weights) - 1:
            a = np.tanh(z)  # скрытые
        else:
            a = sigmoid(z)  # выход
        activations.append(a)
    return activations, zs

def forward_predict(features, weights):
    a = np.array(features, dtype=float)
    for i, w in enumerate(weights):
        z = np.dot(a, w)
        if i < len(weights) - 1:
            a = np.tanh(z)
        else:
            a = sigmoid(z)
    # выход: если выход одномерный — вернуть скаляр
    if np.isscalar(a):
        return float(a)
    return float(a.ravel()[0])

# ----------------------------
# Этап 2: Оценка и обучение (supervised)
# ----------------------------
def mse_loss(preds, targets):
    preds = np.array(preds, dtype=float)
    targets = np.array(targets, dtype=float)
    return float(np.mean((preds - targets) ** 2))

def evaluate_on_dataset(weights, X, y):
    preds = [forward_predict(x, weights) for x in X]
    loss = mse_loss(preds, y)
    # порог 0.5 для метки
    preds_label = [1 if p >= 0.5 else 0 for p in preds]
    accuracy = float(np.mean(np.array(preds_label) == np.array(y)))
    return loss, accuracy

def train_individual(weights, X, y, lr=0.1, epochs=10, batch_size=16):
    """
    Простой батч-стохастический градиентный спуск с backprop.
    weights — список numpy матриц (layers).
    X — список/ndarray признаков (N x n_features)
    y — список/ndarray меток (0/1)
    Возвращает обновлённые веса.
    """
    num_samples = len(X)
    for epoch in range(epochs):
        # перемешиваем данные
        idx = np.arange(num_samples)
        np.random.shuffle(idx)
        for start in range(0, num_samples, batch_size):
            batch_idx = idx[start:start + batch_size]
            # инициализация накопителей градиентов
            grad_acc = [np.zeros_like(w) for w in weights]
            for i in batch_idx:
                xi = X[i]
                yi = y[i]
                activations, zs = forward_store_activations(xi, weights)
                # вычисление ошибки выхода
                output = activations[-1]  # shape (1,) или scalar
                if np.isscalar(output):
                    output = np.array([output])
                error = output - yi  # shape (1,)
                # dL/dz_last = error * sigmoid'
                delta = error * sigmoid_deriv(output)  # shape (1,)
                # backward through layers
                # grad for last weights: a_{L-1}.T dot delta
                a_prev = activations[-2].reshape(-1, 1)  # (n_prev, 1)
                delta = delta.reshape(1, -1)  # (1, n_out)
                grad_acc[-1] += np.dot(a_prev, delta)  # shape matches last weight

                # propagate to previous layers
                delta_prev = delta  # shape (1, n_k)
                for l in range(len(weights) - 2, -1, -1):
                    w_next = weights[l + 1]  # shape (n_l, n_{l+1})
                    # delta for layer l: (w_next dot delta_prev.T).T * tanh'
                    z_l = zs[l]
                    a_l = activations[l + 1]  # after activation
                    # compute (n_l,) vector
                    back = np.dot(delta_prev, w_next.T).reshape(-1)  # shape (n_l,)
                    # derivative of tanh on activation a_l
                    deriv = tanh_deriv(a_l)
                    delta_l = (back * deriv).reshape(1, -1)  # (1, n_l)
                    a_prev = activations[l].reshape(-1, 1)  # (n_{l-1}, 1)
                    grad_acc[l] += np.dot(a_prev, delta_l)  # accumulate

                    delta_prev = delta_l

            # После батча — обновляем веса
            for j in range(len(weights)):
                # средний градиент по батчу
                weights[j] -= (lr / max(1, len(batch_idx))) * grad_acc[j]
    return weights

def train_population(population, X, y, lr=0.1, epochs=5, batch_size=16, progress_callback=None):
    """
    Обучает каждый индивид популяции на всей базе (supervised).
    Возвращает обновлённую популяцию и метрики (loss, acc) для каждого до/после.
    """
    metrics = []
    for idx, indiv in enumerate(population, start=1):
        loss_before, acc_before = evaluate_on_dataset(indiv, X, y)
        indiv = train_individual(indiv, X, y, lr=lr, epochs=epochs, batch_size=batch_size)
        loss_after, acc_after = evaluate_on_dataset(indiv, X, y)
        metrics.append({
            "before": (loss_before, acc_before),
            "after": (loss_after, acc_after)
        })
        if progress_callback:
            progress_callback(idx, len(population))
    return population, metrics

# ----------------------------
# Загрузка обучающей базы
# ----------------------------
def prepare_dataset_from_file(path, suspicious_dict):
    rows = []
    if not os.path.exists(path):
        raise FileNotFoundError(path)
    if path.lower().endswith(".csv"):
        with open(path, "r", encoding="utf-8") as f:
            reader = csv.reader(f)
            header = next(reader, None)
            # попытаемся определить есть ли header с 'url' и 'label'
            has_header = False
            if header:
                cols = [c.strip().lower() for c in header]
                if "url" in cols:
                    has_header = True
            if has_header:
                f.seek(0)
                reader = csv.DictReader(f)
                for r in reader:
                    url = r.get('url') or r.get('URL') or r.get('Url')
                    lab = r.get('label') or r.get('Label') or r.get('LABEL')
                    if not url:
                        continue
                    try:
                        label = int(float(lab)) if lab is not None else 1
                    except Exception:
                        label = 1
                    rows.append((url, 1 if label else 0))
            else:
                # простой CSV: каждая строка — url[,label]
                # если есть второй столбец — попытаемся прочитать как метку
                if header:
                    # header содержал первую строку с URL (нет заголовка), сохраним её
                    if header[0]:
                        try:
                            # попробуем понять, второй столбец есть?
                            second = header[1] if len(header) > 1 else None
                            if second is None:
                                rows.append((header[0], 1))
                            else:
                                try:
                                    lab = int(float(second))
                                    rows.append((header[0], 1 if lab else 0))
                                except Exception:
                                    rows.append((header[0], 1))
                        except Exception:
                            pass
                for line in reader:
                    if not line:
                        continue
                    url = line[0]
                    label = 1
                    if len(line) > 1:
                        try:
                            label = int(float(line[1]))
                        except Exception:
                            label = 1
                    rows.append((url, label))
    else:
        # JSON (простая поддержка)
        with open(path, "r", encoding="utf-8") as f:
            import json
            data = json.load(f)
            if isinstance(data, dict) and 'samples' in data and isinstance(data['samples'], list):
                data = data['samples']
            for item in data:
                if isinstance(item, dict) and 'url' in item:
                    label = int(item.get('label', 1))
                    rows.append((item['url'], label))

    if not rows:
        raise ValueError("Не найдено допустимых URL в файле.")

    X = [extract_features(url, suspicious_dict) for url, _ in rows]
    y = [1 if label else 0 for _, label in rows]
    return X, y

